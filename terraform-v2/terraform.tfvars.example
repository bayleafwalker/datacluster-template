# Hetzner Cloud API Token (REQUIRED)
# Generate at: https://console.hetzner.cloud/ → Security → API Tokens
# Permissions: Read & Write
hcloud_token = "REPLACE_WITH_YOUR_HETZNER_API_TOKEN"

# Tailscale Auth Key (OPTIONAL - for VPN access)
# Generate at: https://login.tailscale.com/admin/settings/keys
# Select: Reusable, Ephemeral
# Leave empty ("") if not using Tailscale
tailscale_auth_key = ""

# Note: All other configuration uses module defaults
# - Talos version: v1.11.5
# - Kubernetes version: v1.34.1
# - Cilium version: v1.18.3
# - Location: hel1 (Helsinki)
# - Control plane: CX23 (2 vCPU, 4GB RAM)
# - Worker: CX33 (4 vCPU, 8GB RAM)
# 
# To customize, see terraform-v2/main.tf module parameters
