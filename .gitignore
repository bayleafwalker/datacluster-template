# SOPS encryption key - NEVER COMMIT THIS!
age.key
*.key
!age.key.example

# Terraform state and local files
terraform-v2/.terraform/
terraform-v2/.terraform.lock.hcl
terraform-v2/terraform.tfstate
terraform-v2/terraform.tfstate.backup
terraform-v2/*.tfplan
terraform-v2/kubeconfig
terraform-v2/talosconfig

# Unencrypted secrets - ALWAYS ENCRYPT BEFORE COMMITTING!
terraform-v2/terraform.tfvars
!terraform-v2/terraform.tfvars.example
talos/cluster.yaml
!talos/cluster.yaml.example

# Kubernetes configs (generated by Terraform)
clusters/.kube/config
kubeconfig
talosconfig

# Packer build artifacts
_packer/packer_cache/
_packer/*.box
_packer/output-*/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log

# Python (if adding PySpark code)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/
